{
  "name": "@ygingold/webhands3d",
  "version": "0.1.0",
  "description": "3D hand tracking in the browser with no special hardware: one webcam, several cameras (including phones over WebRTC), or WebXR headsets, with guided calibration.",
  "keywords": [
    "hand-tracking",
    "hands",
    "3d",
    "webcam",
    "mediapipe",
    "stereo",
    "multi-camera",
    "triangulation",
    "camera-calibration",
    "webrtc",
    "webxr",
    "meta-quest",
    "computer-vision",
    "browser",
    "peerjs"
  ],
  "license": "CC0-1.0",
  "author": "Yotam Gingold",
  "homepage": "https://github.com/yig/webhands3d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yig/webhands3d.git"
  },
  "bugs": {
    "url": "https://github.com/yig/webhands3d/issues"
  },
  "type": "module",
  "main": "./dist/webhands.js",
  "module": "./dist/webhands.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webhands.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "WEBHANDS_LAN=1 vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node tools/smoke.mjs",
    "replay": "f() { WEBHANDS_RECORDING=\"$1\" vitest run test/replay.test.ts --silent=false --reporter=dot; }; f",
    "prepublishOnly": "npm test && npm run build",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --outDir dist-demo"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.64.1",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
