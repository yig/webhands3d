{
  "name": "webhands",
  "version": "0.1.0",
  "description": "3D hand tracking in the browser with no special hardware",
  "type": "module",
  "main": "./dist/webhands.js",
  "module": "./dist/webhands.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/webhands.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lan": "WEBHANDS_LAN=1 vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node tools/smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
